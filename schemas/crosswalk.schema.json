{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prior chapter crosswalk row",
  "type": "object",
  "required": [
    "chapter",
    "title",
    "dossiers",
    "assessment"
  ],
  "properties": {
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "dossiers": {
      "type": "string",
      "minLength": 1
    },
    "assessment": {
      "type": "string",
      "minLength": 1
    }
  }
}
