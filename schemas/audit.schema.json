{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit item",
  "type": "object",
  "required": [
    "id",
    "earlier_claim",
    "verdict",
    "corrected_treatment",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^A[0-9]{3,}$"
    },
    "earlier_claim": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*$"
    },
    "corrected_treatment": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^S[0-9]{3,}$"
      }
    }
  }
}
